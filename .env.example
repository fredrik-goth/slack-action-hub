# ==============================================================================
# SLACK CONFIGURATION
# ==============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN only needed for local dev (Socket Mode). Not used on Netlify.
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ==============================================================================
# SECURITY — Encryption key for per-user credential storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ==============================================================================
# GOOGLE OAUTH — App-level credentials (shared across all users)
# Each user authenticates individually via the App Home tab.
# Production redirect URI: https://<your-site>.netlify.app/oauth/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Gmail filter for "actionable" messages (applied per user)
GMAIL_QUERY=is:starred OR label:TODO OR label:"Action Required"

# ==============================================================================
# TRELLO — App-level API Key (each user provides their own Token via onboarding)
# Get your API Key from: https://trello.com/app-key
# ==============================================================================
TRELLO_API_KEY=your-trello-api-key

# ==============================================================================
# APPLICATION
# ==============================================================================
PORT=3000
NODE_ENV=development

# Daily morning digest cron (default: 9:00 AM Monday–Friday UTC)
# On Netlify this is controlled by netlify.toml — this is only for local dev.
DIGEST_CRON_SCHEDULE="0 9 * * 1-5"

# ==============================================================================
# CHANNEL WATCHER — #Uppdrag assignment channel
# Find the channel ID by opening #uppdrag in Slack, then:
#   Right-click the channel name → View channel details → copy the ID at the bottom
#   It looks like: C0123456789
# ==============================================================================
UPPDRAG_CHANNEL_ID=C0123456789
